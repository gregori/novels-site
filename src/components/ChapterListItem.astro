---
interface Props {
  chapterTitle: string;
  publishDate: Date;
  href: string;
  volume?: number;
}

const { chapterTitle, publishDate, href, volume } = Astro.props;
const formattedDate = publishDate.toISOString().slice(0, 10);
---

<li class="chapter-list-item">
  <a href={href} data-testid="chapter-link">
    {volume && <span class="chapter-list-item__volume">Volume {volume}</span>}
    {chapterTitle}
  </a>
  <time datetime={publishDate.toISOString()} class="chapter-list-item__date">{formattedDate}</time>
</li>

<style>
  .chapter-list-item {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    padding-block: var(--space-1);
    border-bottom: 1px solid var(--color-border);
  }
  .chapter-list-item a {
    text-decoration: none;
    color: var(--color-text);
  }
  .chapter-list-item__volume {
    color: var(--color-text-muted);
    font-size: 0.8rem;
    margin-right: var(--space-1);
  }
  .chapter-list-item__date {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    white-space: nowrap;
  }
</style>
