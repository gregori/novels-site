<!--
  giscus comments (GitHub Discussions-backed). Fails silently if blocked
  (NFR Design resilience pattern) — this section simply stays empty.

  TODO one-time setup (see aidlc-docs/construction/novels-site/code/deployment-notes.md):
  1. Enable Discussions on gregori/novels-site
  2. Install the giscus app: https://github.com/apps/giscus
  3. Get your repo-id/category-id from https://giscus.app and replace the
     placeholders below.
-->
<section class="comments-widget" data-testid="comments-widget" aria-label="Comments">
  <script
    src="https://giscus.app/client.js"
    data-repo="gregori/novels-site"
    data-repo-id="REPLACE_WITH_REPO_ID"
    data-category="Comments"
    data-category-id="REPLACE_WITH_CATEGORY_ID"
    data-mapping="pathname"
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="bottom"
    data-theme="preferred_color_scheme"
    data-lang="en"
    crossorigin="anonymous"
    async></script>
</section>
