---

---

<details class="typography-panel" data-testid="typography-panel">
  <summary class="button">Aa Reading settings</summary>
  <div class="typography-panel__body">
    <fieldset>
      <legend>Font</legend>
      <label for="font-family-select" class="visually-hidden">Font family</label>
      <select id="font-family-select" data-testid="font-family-select">
        <option value="serif">Serif</option>
        <option value="sans">Sans-serif</option>
      </select>
    </fieldset>

    <fieldset>
      <legend>Text size</legend>
      <label
        ><input type="radio" name="font-size" value="sm" data-testid="font-size-sm" /> Small</label
      >
      <label
        ><input type="radio" name="font-size" value="md" data-testid="font-size-md" /> Medium</label
      >
      <label
        ><input type="radio" name="font-size" value="lg" data-testid="font-size-lg" /> Large</label
      >
      <label
        ><input type="radio" name="font-size" value="xl" data-testid="font-size-xl" /> Extra large</label
      >
    </fieldset>

    <fieldset>
      <legend>Line spacing</legend>
      <label
        ><input
          type="radio"
          name="line-spacing"
          value="compact"
          data-testid="line-spacing-compact"
        />
        Compact</label
      >
      <label
        ><input
          type="radio"
          name="line-spacing"
          value="comfortable"
          data-testid="line-spacing-comfortable"
        />
        Comfortable</label
      >
      <label
        ><input
          type="radio"
          name="line-spacing"
          value="relaxed"
          data-testid="line-spacing-relaxed"
        />
        Relaxed</label
      >
    </fieldset>
  </div>
</details>

<style>
  .typography-panel__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-2) 0;
  }
  .typography-panel__body fieldset {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-2);
  }
</style>

<script>
  import {
    resolveInitialFontFamily,
    resolveInitialFontSize,
    resolveInitialLineSpacing,
    setFontFamily,
    setFontSize,
    setLineSpacing,
  } from '../scripts/typography';

  const fontSelect = document.getElementById('font-family-select') as HTMLSelectElement | null;
  const sizeInputs = document.querySelectorAll<HTMLInputElement>('input[name="font-size"]');
  const spacingInputs = document.querySelectorAll<HTMLInputElement>('input[name="line-spacing"]');

  const initialFamily = resolveInitialFontFamily(localStorage.getItem('fontFamily'));
  const initialSize = resolveInitialFontSize(localStorage.getItem('fontSize'));
  const initialSpacing = resolveInitialLineSpacing(localStorage.getItem('lineSpacing'));

  if (fontSelect) fontSelect.value = initialFamily;
  sizeInputs.forEach((input) => {
    input.checked = input.value === initialSize;
  });
  spacingInputs.forEach((input) => {
    input.checked = input.value === initialSpacing;
  });

  fontSelect?.addEventListener('change', () => {
    setFontFamily(fontSelect.value as 'serif' | 'sans');
  });
  sizeInputs.forEach((input) => {
    input.addEventListener('change', () => {
      if (input.checked) setFontSize(input.value as 'sm' | 'md' | 'lg' | 'xl');
    });
  });
  spacingInputs.forEach((input) => {
    input.addEventListener('change', () => {
      if (input.checked) setLineSpacing(input.value as 'compact' | 'comfortable' | 'relaxed');
    });
  });
</script>
