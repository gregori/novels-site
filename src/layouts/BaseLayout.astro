---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Fan translations of Japanese webnovels and light novels.' } =
  Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Forgotten Translations</title>
    <meta name="description" content={description} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Forgotten Translations"
      href="/rss.xml"
    />
    {
      /*
        astro dev's HMR client relies on inline styles/scripts that this CSP
        would block, so the policy only ships in the production build.
      */
    }
    {
      !import.meta.env.DEV && (
        <meta
          http-equiv="Content-Security-Policy"
          content="default-src 'self'; script-src 'self' https://giscus.app https://gc.zgo.at; style-src 'self' https://giscus.app; frame-src https://giscus.app; connect-src 'self' https://giscus.app https://gc.zgo.at; img-src 'self' data: https://avatars.githubusercontent.com"
        />
      )
    }
    <!--
      Blocking, non-module, same-origin script (public/theme-init.js): applies
      the reader's stored theme/typography preferences before first paint to
      avoid a flash of the wrong theme. Must be an external file rather than
      is:inline — the CSP's script-src has no unsafe-inline/hash, so an inline
      <script> here would be silently blocked in production. A plain <script
      src="..."> with no type="module"/async/defer stays render-blocking, so
      it still runs before first paint like the inline version did.
    -->
    <script is:inline src="/theme-init.js"></script>
  </head>
  <body>
    <SiteHeader />
    <main class="site-container">
      <slot />
    </main>
    <SiteFooter />
    <!--
      GoatCounter analytics: fails silently if blocked (NFR Design resilience
      pattern). Replace data-goatcounter with your own account's endpoint —
      see aidlc-docs/construction/novels-site/code/deployment-notes.md.
    -->
    <script
      is:inline
      async
      src="https://gc.zgo.at/count.js"
      data-goatcounter="https://forgottentranslations.goatcounter.com/count"></script>
  </body>
</html>
