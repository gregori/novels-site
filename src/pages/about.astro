import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About" description="About this fan-translation site and its translator.">
  <h1>About</h1>
  <p>
    Forgotten Translations is a hobby project: Japanese webnovels and light novels translated into
    English for fun and for practice, and shared here for free.
  </p>
  <p>
    All original works belong to their respective authors and publishers. These translations are
    unofficial, non-commercial, and fan-made — please support the original authors if an official
    translation becomes available.
  </p>
  <p>
    Found a mistake or want to chat about a chapter? Use the comments on any chapter page, or open
    an issue on the <a href="https://github.com/gregori/novels-site">GitHub repository</a>.
  </p>
</BaseLayout>
