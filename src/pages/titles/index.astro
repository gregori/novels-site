---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TitleCard from '../../components/TitleCard.astro';
import { getCollection } from 'astro:content';

const titles = (await getCollection('titles')).sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout title="Titles">
  <h1>All Titles</h1>
  {titles.map((title) => <TitleCard title={title} />)}
</BaseLayout>
